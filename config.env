# ============================================================================
# ISDA_Search — SINGLE CENTRAL CONFIG
# ----------------------------------------------------------------------------
# Everything environment-specific lives HERE. To rebuild in a new workspace /
# machine: edit the values below, then follow README.md ("Rebuild elsewhere").
#
# SECRETS / AUTH ARE **NOT** STORED IN THIS REPO.
# Authentication uses the Databricks CLI (OAuth U2M). Before running anything:
#     databricks auth login --host <DBX_HOST> --profile <DBX_PROFILE>
# The OAuth token is cached by the CLI in ~/.databrickscfg + ~/.databricks/
# (outside this repo). No PATs, passwords, or tokens belong in this file or the
# repo. If a specific step ever needs a PAT, put it in `.env.local` (which is
# git-ignored) and export it — never commit it.
# ============================================================================

# --- Databricks workspace / auth -------------------------------------------
DBX_PROFILE=sa-ccr
DBX_HOST=https://fevm-serverless-stable-pdu5ct.cloud.databricks.com
DBX_WAREHOUSE_ID=78e7294c42f67d58

# --- Unity Catalog target ---------------------------------------------------
# The deploy will try to create a standalone catalog named ISDA_CATALOG; if the
# workspace disallows it, it falls back to a schema of that name inside
# ISDA_FALLBACK_CATALOG.
ISDA_CATALOG=isda_search
ISDA_FALLBACK_CATALOG=serverless_stable_pdu5ct_catalog
ISDA_SCHEMA=isda
ISDA_VOLUME=contracts

# --- Vector Search / models -------------------------------------------------
VS_ENDPOINT=isda-search-endpoint
FTS_ENDPOINT=isda-fts-endpoint
EMBED_MODEL=databricks-gte-large-en
LLM_MODEL=databricks-claude-sonnet-4-6

# --- Databricks App ---------------------------------------------------------
APP_NAME=isda-contract-search
# APP_SP is the app's service-principal client_id. It is MINTED when the app is
# first created (deploy/00_create_app.py) and written back here automatically.
# Leave blank for a fresh environment.
APP_SP=aa24ad9f-dda0-483d-8e65-09067dc883c9
